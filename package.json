{
    "name": "@tvaliasek/vue-form-inputs",
    "version": "5.2.4",
    "private": false,
    "files": [
        "src",
        "dist",
        "!src/stories",
        "!src/components/__tests__",
        "!src/main.ts",
        "!src/App.vue",
        "!dist/index.html",
        "!dist/favicon.ico"
    ],
    "exports": {
        ".": {
            "import": {
                "types": "./dist/index.d.mts",
                "default": "./dist/vue-form-inputs.mjs"
            },
            "require": {
                "types": "./dist/index.d.ts",
                "default": "./dist/vue-form-inputs.umd.cjs"
            }
        },
        "./dist/vue-form-inputs.css": {
            "import": "./dist/vue-form-inputs.css",
            "require": "./dist/vue-form-inputs.css"
        },
        "./Inputs/*": {
            "types": "./dist/Inputs/*.vue.d.ts",
            "import": "./src/Inputs/*.vue"
        },
        "./Inputs/*.vue": {
            "types": "./dist/Inputs/*.vue.d.ts",
            "import": "./src/Inputs/*.vue"
        },
        "./Inputs/Bootstrap/*": {
            "types": "./dist/Inputs/Bootstrap/*.vue.d.ts",
            "import": "./src/Inputs/Bootstrap/*.vue"
        },
        "./Inputs/Bootstrap/*.vue": {
            "types": "./dist/Inputs/Bootstrap/*.vue.d.ts",
            "import": "./src/Inputs/Bootstrap/*.vue"
        },
        "./package.json": "./package.json"
    },
    "types": "./dist/index.d.ts",
    "main": "dist/vue-form-inputs.umd.cjs",
    "module": "dist/vue-form-inputs.mjs",
    "homepage": "https://github.com/tvaliasek/vue-form-inputs#readme",
    "bugs": {
        "url": "https://github.com/tvaliasek/vue-form-inputs/issues"
    },
    "keywords": [
        "form",
        "form input",
        "bootstrap",
        "vue"
    ],
    "license": "MIT",
    "author": {
        "name": "Tomáš Valiašek",
        "url": "https://github.com/tvaliasek"
    },
    "scripts": {
        "dev": "vite",
        "build": "run-s type-check build-only build:types",
        "preview": "vite preview",
        "build-only": "vite build",
        "build:types": "vue-tsc -p tsconfig.declarations.json && node scripts/copy-esm-types.mjs",
        "type-check": "vue-tsc --build",
        "lint:oxlint": "oxlint . --fix -D correctness --ignore-path .oxlintignore",
        "lint:eslint": "eslint . --fix",
        "lint": "run-s lint:*"
    },
    "dependencies": {
        "@vueuse/core": "^14.3.0",
        "date-fns": "^4.1.0",
        "vue": "^3.5.34"
    },
    "peerDependencies": {
        "@vuepic/vue-datepicker": "*",
        "date-fns": "*",
        "bootstrap": "^5.3.8"
    },
    "devDependencies": {
        "@iconify-json/bi": "^1.2.7",
        "@popperjs/core": "^2.11.8",
        "@stylistic/eslint-plugin": "^5.10.0",
        "@tsconfig/node24": "^24.0.4",
        "@types/jsdom": "^28.0.1",
        "@types/node": "^24.12.2",
        "@vitejs/plugin-vue": "^6.0.6",
        "@vue/eslint-config-typescript": "^14.7.0",
        "@vue/language-core": "~3.1.5",
        "@vue/tsconfig": "^0.9.1",
        "@vuelidate/core": "^2.0.3",
        "@vuelidate/validators": "^2.0.4",
        "@vuepic/vue-datepicker": "^12.1.0",
        "bootstrap": "^5.3.8",
        "cross-env": "^10.1.0",
        "eslint": "^10.3.0",
        "eslint-plugin-oxlint": "^1.63.0",
        "eslint-plugin-vue": "^10.9.1",
        "jiti": "^2.7.0",
        "jsdom": "^29.1.1",
        "npm-run-all2": "^8.0.4",
        "oxlint": "^1.63.0",
        "sass": "^1.99.0",
        "typescript": "~5.9.3",
        "vite": "^8.0.10",
        "vite-plugin-vue-devtools": "^8.1.1",
        "vitest": "^4.1.5",
        "vue-i18n": "^11.4.0",
        "vue-tsc": "^3.2.8"
    }
}
